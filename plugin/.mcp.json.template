{
  "mcpServers": {
    "eunomai-business": {
      "command": "{{UVX}}",
      "args": ["--from", "{{CONNECTOR}}", "-c", "{{CONSTRAINTS}}", "eunomai-business"],
      "env": {
        "EUNOMAI_EXPANSION_PROBE": "${CLAUDE_PLUGIN_ROOT}",
        "EUNOMAI_PROVIDERS": "{{PROVIDERS}}",
        "EUNOMAI_WORKSPACES_ROOT": "{{WORKSPACES_ROOT}}",
        "EUNOMAI_DIAGNOSTICS": "{{DIAGNOSTICS}}",
        "EUNOMAI_SUPPORT_EMAIL": "{{SUPPORT_EMAIL}}",
        "EUNOMAI_SPECIALIST": "{{SPECIALIST}}"
      }
    }
  }
}
