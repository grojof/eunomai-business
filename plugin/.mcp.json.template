{
  "mcpServers": {
    "{{PLUGIN}}": {
      "command": "{{UV}}",
      "args": ["run", "--no-project", "--no-config", "--system-certs", "--managed-python", "--python", "3.12",
               "{{CONNECTOR}}/start.py", "{{PLUGIN}}", "eunomai-business"],
      "env": {
        "EUNOMAI_EXPANSION_PROBE": "${CLAUDE_PLUGIN_ROOT}",
        "EUNOMAI_PLUGIN": "{{PLUGIN}}",
        "EUNOMAI_PLATFORM": "{{PLATFORM}}",
        "EUNOMAI_PROVIDERS": "{{PROVIDERS}}",
        "EUNOMAI_WORKSPACES_ROOT": "{{WORKSPACES_ROOT}}",
        "EUNOMAI_DIAGNOSTICS": "{{DIAGNOSTICS}}",
        "EUNOMAI_SUPPORT_EMAIL": "{{SUPPORT_EMAIL}}",
        "EUNOMAI_SPECIALIST": "{{SPECIALIST}}",
        "EUNOMAI_BUILD": "{{BUILD}}"
      }
    }
  }
}
