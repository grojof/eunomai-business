{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|mcp__workspace__bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{UV_COMMAND}} run --frozen --no-dev --no-config --native-tls --python 3.12 --project \"{{CONNECTOR}}\" eunomai-business-guard",
            "timeout": 30,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
