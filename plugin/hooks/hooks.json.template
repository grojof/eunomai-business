{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|mcp__workspace__bash|mcp__.*eunomai-business.*",
        "hooks": [
          {
            "type": "command",
            "command": "{{UV_COMMAND}} run --frozen --no-dev --no-config --system-certs --managed-python --python 3.12 --project \"{{CONNECTOR}}\" eunomai-business-guard",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
