{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{UV_COMMAND}} run --no-project --no-config --system-certs --managed-python --python 3.12 \"{{CONNECTOR}}/start.py\" {{PLUGIN}} eunomai-business-guard --plugin {{PLUGIN}} --policy \"${CLAUDE_PLUGIN_ROOT}/policy.json\"",
            "timeout": 60,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{UV_COMMAND}} run --no-project --no-config --system-certs --managed-python --python 3.12 \"{{CONNECTOR}}/start.py\" {{PLUGIN}} eunomai-business-guard --plugin {{PLUGIN}} --policy \"${CLAUDE_PLUGIN_ROOT}/policy.json\"",
            "timeout": 60,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|mcp__workspace__bash)$|^mcp__(plugin_{{PLUGIN}}_)?{{PLUGIN}}__",
        "hooks": [
          {
            "type": "command",
            "command": "{{UV_COMMAND}} run --no-project --no-config --system-certs --managed-python --python 3.12 \"{{CONNECTOR}}/start.py\" {{PLUGIN}} eunomai-business-guard --plugin {{PLUGIN}} --policy \"${CLAUDE_PLUGIN_ROOT}/policy.json\"",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
