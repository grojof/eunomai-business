{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "{{UV_COMMAND}} run --frozen --no-dev --no-config --system-certs --managed-python --python 3.12 --project \"{{CONNECTOR}}\" eunomai-business-hook --plugin {{PLUGIN}}", "timeout": 60, "onFailure": "continue" }
        ]
      }
    ],
    "PreToolUse": [
      {
