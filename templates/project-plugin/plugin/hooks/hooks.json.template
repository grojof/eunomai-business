{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|mcp__workspace__bash)$|^mcp__(plugin_{{NAME}}_)?{{NAME}}__",
        "hooks": [
          {
            "type": "command",
            "command": "{{UV_COMMAND}} run --no-project --no-config --managed-python --python 3.12 \"${CLAUDE_PLUGIN_ROOT}/server/hook.py\" --config \"${CLAUDE_PLUGIN_ROOT}/project.json\"",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
