# /etc/follow-branch/<name>.env, owned by root, mode 0600: systemd reads it, nothing else needs to.
# Only how to fetch the branch and what applies it. The deploy key is /etc/follow-branch/<name>.key and the git
# server's host keys /etc/follow-branch/known_hosts, both handed to the unit as credentials. The application's own
# credentials go in its own configuration on this server, never in the repository or on the git server.

# A read-only deploy key on the repository: GitHub, Gitea and GitLab offer them.
REPOSITORY=ssh://git@git.example.internal/team/example-project.git
BRANCH=pruebas

# IT's own command, outside the repository: what this application needs to go live (see apply.example.sh).
APPLY=/usr/local/lib/follow-branch/apply-example-project.sh
APPLY_TIMEOUT=600
KEEP=3
